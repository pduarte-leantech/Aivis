{
  "name": "aivis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bootstrap:admin": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "verify:dicom-runtime": "node scripts/verify-dicom-runtime.mjs",
    "uploads:cleanup": "node --env-file=.env.local scripts/cleanup-uploads.mjs"
  },
  "dependencies": {
    "@itk-wasm/dicom": "7.6.4",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "dicom-parser": "1.8.21",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/nft": "1.11.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "overrides": {
    "decompress": "npm:@xhmikosr/decompress@11.1.4"
  }
}
