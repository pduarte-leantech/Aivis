# Public Supabase project configuration (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning
# Explicit consent gate: only enable after contracts/privacy/legal review.
AI_PROCESSING_ENABLED=false
# Canonical origin, no trailing slash; required in production for CSRF protection.
APP_URL=http://localhost:3000
